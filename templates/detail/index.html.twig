{% extends 'base.html.twig' %}

{% block title %}Distribution{% endblock %}

{% block body %}

   {% include 'detail/partials/_plaque.html.twig' %}
<div id="vehicule"></div>
      <div class="m-[auto] w-[400px] mt-[50px] mb-[100px]">
          
        {% for detail in details %}
            
             <div class=" bg-gray-500 mt-[20px] border-[2.5px] border-[#FEDA08] rounded-lg p-4" >
                <h1 class="font-bold text-xl text-[#FEDA08]">{{ detail.titre }}</h1>

               <br>
                <div class=" font-sans text-lg">{{ detail.description }}</div>
                <div class="text-[#27F531] font-bold">{{ detail.tarif }} €</div>
             </div>
        {% endfor %}
       </div>

      
{% endblock %}
